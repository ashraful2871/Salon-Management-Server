model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  name         String
  phone        String?
  profilePhoto String?
  gender       Gender?
  dateOfBirth  DateTime?
  address       String?
  emailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  /// Bumped to revoke every outstanding session and verification ticket.
  sessionVersion Int      @default(0)
  /// Seed or demo account; hidden from admin lists by default.
  isTest          Boolean   @default(false)
  statusReason    String?
  statusChangedAt DateTime?
  /// SUSPENDED until then; the users.unsuspend job reactivates after it.
  suspendedUntil  DateTime?
  /// Bumped by auth() at most every 15 minutes.
  lastActiveAt    DateTime?
  isDeleted    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  admin        Admin?
  salonOwner   SalonOwner?
  staff        Staff?
  agent        Agent?
  appointments Appointment[]
  reviews      Review[]
  verificationTokens VerificationToken[]
  wallet             Wallet?
  paymentIntents     PaymentIntent[]
  assistantConversations AssistantConversation[]
  otpChallenges          OtpChallenge[]
  authIdentities         AuthIdentity[]
  mfa                    UserMfa?

  @@index([status, suspendedUntil])
  @@index([createdAt])
  @@map("users")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256 of the token that was emailed
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Admin {
  id                String   @id @default(uuid())
  userId            String   @unique
  canManageUsers    Boolean  @default(true)
  canManageSalons   Boolean  @default(true)
  canManageServices Boolean  @default(true)
  canViewReports    Boolean  @default(true)
  adminRole         AdminRole @default(ANALYST)
  invitedById       String?
  alertEmails       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model SalonOwner {
  id                 String  @id @default(uuid())
  userId             String  @unique
  businessName       String?
  businessAddress    String?
  businessPhone      String?
  businessEmail      String?
  verificationStatus Boolean @default(false)
  documentUrl        String?

  // ✅ add these
  applicationStatus OwnerApplicationStatus @default(PENDING)
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  salons Salon[]

  @@map("salon_owners")
}

model Agent {
  id        String   @id @default(uuid())
  userId    String   @unique
  division  String
  district  String
  area      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agents")
}

/// One emailed 6-digit code. Only an HMAC of it is stored. One live row per
/// (user, purpose): issuing a new code consumes the older ones.
model OtpChallenge {
  id          String     @id            // generated in app code: it is part of the HMAC
  userId      String
  purpose     OtpPurpose
  channel     OtpChannel @default(EMAIL)
  target      String                    // the exact address the code went to
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?                 // used, superseded or locked
  requestIp   String?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_challenges")
}

/// A sign-in method from an outside identity provider, keyed on the provider's
/// stable subject id (Google "sub"), never on the email.
model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String       // at link time, for support only
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// TOTP second factor for ADMIN and AGENT accounts. The secret is stored
/// AES-256-GCM encrypted ("iv:tag:ciphertext"); recovery codes as sha256.
model UserMfa {
  userId             String    @id
  secretEnc          String
  enabledAt          DateTime? // null while enrolling
  lastUsedStep       Int?      // replay guard: the last accepted 30 s step
  recoveryCodeHashes String[]
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  stepUpUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// An emailed invitation to join as an ADMIN or AGENT. Only the sha256 of the
/// token is stored; accepting claims the row once.
model AdminInvitation {
  id               String           @id @default(uuid())
  email            String           // normalised
  kind             String           // ADMIN | AGENT
  name             String?
  adminRole        AdminRole?
  division         String?
  district         String?
  area             String?
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  invitedById      String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime         @default(now())

  @@index([email, status])
  @@map("admin_invitations")
}
