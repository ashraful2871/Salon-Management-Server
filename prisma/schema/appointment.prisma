model Appointment {
  id                 String            @id @default(uuid())
  customerId         String
  salonId            String
  serviceId          String
  staffId            String?
  counterId          String
  appointmentDate    DateTime
  startTime          String
  endTime            String?
  status             AppointmentStatus @default(PENDING)
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  slotId             String?

  /// What the customer is called at the counter. `token` is the short code on
  /// the confirmation ("TKN-A8F2"); `serialNumber` is their place in the queue
  /// for this salon + service + day, so #1 is served before #2. Both are
  /// optional because bookings made before this existed have neither.
  token        String? @unique
  serialNumber Int?

  // Money, captured at booking time so a later price change cannot rewrite
  // what this customer agreed to pay.
  totalMinor    Int           @default(0)
  depositMinor  Int           @default(0)
  depositStatus DepositStatus @default(NONE)

  /// Whether we brought this customer to the salon. Drives commission: a
  /// salon's own repeat customer is never commissioned.
  source AppointmentSource @default(PLATFORM)

  // No-show handling. A forfeit is appealable for 48 hours; publishing that is
  // what keeps the mechanic from feeling arbitrary.
  noShowMarkedAt DateTime?
  appealedAt     DateTime?
  appealReason   String?
  appealStatus   AppealStatus?

  // Relations
  customer      User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff         Staff?        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  counter       Counter?      @relation(fields: [counterId], references: [id])
  payment       Payment?
  review        Review?
  slot          Slot?         @relation(fields: [slotId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([salonId, status])
  @@index([customerId, salonId])
  // Backs the "what serial comes next" lookup on every booking.
  @@index([salonId, serviceId, appointmentDate])
  @@map("appointments")
}
