model Appointment {
  id                 String            @id @default(uuid())
  customerId         String
  salonId            String
  serviceId          String
  staffId            String?
  counterId          String
  appointmentDate    DateTime
  startTime          String
  endTime            String?
  status             AppointmentStatus @default(PENDING)
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  slotId             String?

  /// What the customer is called at the counter. `token` is the short code on
  /// the confirmation ("TKN-A8F2"); `serialNumber` is their place in the queue,
  /// where a queue is salon + service + counter + day. It is copied from
  /// `slot.sequenceNo` at booking, so it follows slot time rather than booking
  /// order and never changes afterwards. Both are optional because bookings
  /// made before this existed have neither.
  token        String? @unique
  serialNumber Int?

  // Money, captured at booking time so a later price change cannot rewrite
  // what this customer agreed to pay.
  totalMinor    Int           @default(0)
  depositMinor  Int           @default(0)
  depositStatus DepositStatus @default(NONE)

  /// Whether we brought this customer to the salon. Drives commission: a
  /// salon's own repeat customer is never commissioned.
  source AppointmentSource @default(PLATFORM)

  // No-show handling. A forfeit is appealable for 48 hours; publishing that is
  // what keeps the mechanic from feeling arbitrary.
  noShowMarkedAt DateTime?
  appealedAt     DateTime?
  appealReason   String?
  appealStatus   AppealStatus?

  // Arrival and checkout, stamped by whoever pressed the button at the
  // counter. The *ById fields are plain user ids with no relation: they are an
  // audit trail, and a null completedById means the stale-checkout job closed
  // the booking rather than a person.
  checkedInAt   DateTime?
  completedAt   DateTime?
  checkedInById String?
  completedById String?

  // Relations
  customer      User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff         Staff?        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  counter       Counter?      @relation(fields: [counterId], references: [id])
  payment       Payment?
  review        Review?
  slot          Slot?         @relation(fields: [slotId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([salonId, status])
  @@index([customerId, salonId])
  // Backs listing one salon's bookings for a service and day.
  @@index([salonId, serviceId, appointmentDate])
  @@map("appointments")
}
