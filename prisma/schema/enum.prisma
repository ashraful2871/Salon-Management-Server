}

/// How a booking reached us. Set on the appointment at creation and never
/// changed: it is what answers "how many bookings did the chat produce".
enum BookingChannel {
  WEB
  ASSISTANT
  WALK_IN
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  SUPPORT
  MODERATOR
  ANALYST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Four-eyes approvals: PENDING until a second admin decides or 24 h pass.
/// APPROVED is the claimed state while the action runs; it ends EXECUTED or FAILED.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

/// Review moderation: HIDDEN reviews drop out of every public read and out of
/// the salon/staff rating. Text is never edited.
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// Support tickets: OPEN until an admin replies (PENDING = waiting on the
/// requester), RESOLVED by an admin, CLOSED by the support.autoclose job.
enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Why a salon is not taking new online bookings. DUES is set and cleared only
/// by the dues.watch job / a dues payment; it never touches OWNER.
enum BookingPause {
  NONE
  OWNER
  DUES
}

