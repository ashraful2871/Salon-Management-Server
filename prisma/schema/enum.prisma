  STAFF
  SALON_OWNER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  MOBILE_BANKING
}

enum ServiceCategory {
  HAIRCUT
  STYLING
  COLORING
  TREATMENT
  SPA
  FACIAL
  MANICURE
  PEDICURE
  MAKEUP
  WAXING
  MASSAGE
  OTHER
}

enum StaffStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
  INACTIVE
}

enum SalonStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  REJECTED
}

enum LocationAccuracy {
  EXACT
  APPROXIMATE
}

enum OwnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  CANCELLED
  COMPLETED
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum WalletTxType {
  TOPUP // + gateway top-up
  TOPUP_REVERSAL // - failed or charged-back top-up
  DEPOSIT_HOLD // 0 net; moves balance -> heldBalance
  DEPOSIT_RELEASE // 0 net; moves heldBalance -> balance
  DEPOSIT_APPLIED // - deposit consumed against a completed booking
  DEPOSIT_FORFEIT // - deposit lost to a no-show
  REFUND // + platform or salon initiated refund
  CASHBACK // + loyalty reward
  GOODWILL_CREDIT // + compensation when a salon cancels
  ADJUSTMENT // +/- manual admin correction, always with a reason
  WITHDRAWAL // - cash-out, if it is ever allowed
}

enum IntentPurpose {
  WALLET_TOPUP
  BOOKING
}

enum IntentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum DepositStatus {
  NONE
  HELD
  RELEASED
  APPLIED
  FORFEITED
  // A late cancellation: part of the deposit went to the salon as a penalty,
  // the rest went back to the customer. Not appealable - they chose to cancel.
  PARTIALLY_FORFEITED
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentSource {
  PLATFORM // discovered and booked through us - commission may apply
  SALON_DIRECT // the salon's own customer - never commissioned
}

enum LedgerAccount {
  SALON_PAYABLE
  PLATFORM_REVENUE
  CUSTOMER_WALLET
  GATEWAY_CLEARING
}

enum CommissionScope {
  NEW_CUSTOMER
  OFF_PEAK
  ALL
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum AssistantRole {
  USER
  ASSISTANT
  TOOL
}

/// How a booking reached us. Set on the appointment at creation and never
/// changed: it is what answers "how many bookings did the chat produce".
enum BookingChannel {
  WEB
  ASSISTANT
  WALK_IN
}
