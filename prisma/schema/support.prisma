/// A support conversation. Contact-form messages open one; admins reply by
/// email from the back office. userId/appointmentId are best-effort links.
model SupportTicket {
  id              String         @id @default(uuid())
  number          Int            @unique @default(autoincrement())
  source          String // CONTACT_FORM | DASHBOARD | ADMIN
  name            String
  email           String
  userId          String?
  appointmentId   String?
  subject         String
  category        String         @default("OTHER")
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assigneeId      String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages SupportMessage[]

  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@index([email])
  @@map("support_tickets")
}

model SupportMessage {
  id         String    @id @default(uuid())
  ticketId   String
  authorType String // CUSTOMER | ADMIN | SYSTEM
  authorId   String?
  body       String
  internal   Boolean   @default(false)
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
