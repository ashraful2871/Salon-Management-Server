/// The in-chat booking assistant. A conversation is a booking draft plus the
/// transcript that produced it: the draft lives in `state` (zod-validated on
/// every read and write, so a state written by an older deploy degrades to a
/// fresh greeting rather than locking a customer out), and every turn is kept
/// so a chat can be reopened on another device and audited later.
model AssistantConversation {
  id            String   @id @default(uuid())
  userId        String? // null until a guest signs in
  anonymousId   String? // guest owner key, returned once on create
  locale        String   @default("en")
  state         Json // the booking draft; zod-validated on every read/write
  status        String   @default("ACTIVE") // ACTIVE | BOOKED | ABANDONED
  appointmentId String? // the booking it produced
  turnCount     Int      @default(0)
  expiresAt     DateTime // retention sweep
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, createdAt])
  @@index([anonymousId])
  @@index([expiresAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AssistantRole
  text           String?
  blocks         Json? // UI blocks sent with this message
  action         Json? // the structured action that produced it
  model          String?
  promptVersion  String?
  latencyMs      Int?
  tokensIn       Int?
  tokensOut      Int?
  feedback       Int? // 👍 1 / 👎 -1 from the customer; null when not rated
  feedbackReason String?
  /// The turn's outcome, on the assistant row: ok | blocked | error |
  /// rate_limited | slot_taken | insufficient_funds. The funnel report
  /// (`GET /assistant/stats`) counts the ones that are not ok.
  outcome        String?
  createdAt      DateTime      @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}
