model Salon {
  id             String                      @id @default(uuid())
  name           String
  description    String?
  website        String?
  address        String
  area           String                      @default("N/A")
  district       String                      @default("N/A")
  division       String                      @default("N/A")
  city           String
  state          String?
  zipCode        String?
  latitude          Float?
  longitude         Float?
  locationAccuracy  LocationAccuracy?
  locationUpdatedAt DateTime?
  phone          String
  email          String?
  images         String[]
  operatingHours Json?
  status         SalonStatus                 @default(PENDING_APPROVAL)
  rating         Float                       @default(0)
  totalReviews   Int                         @default(0)
  ownerId        String
  isDeleted      Boolean                     @default(false)
  embedding      Unsupported("vector(768)")?

  // Deposit policy. `depositPercent` wins when set, otherwise `depositMinor`;
  // either way the result is clamped to the platform min/max in
  // appointment.deposit.ts. A deposit is what makes a no-show cost something.
  depositMinor          Int  @default(3000) // BDT 30
  depositPercent        Int? // of the service price, when a flat fee is too blunt
  cancellationWindowMin Int  @default(120) // free cancellation up to 2h before
  noShowSalonSharePct   Int  @default(70) // salon's cut of a forfeited deposit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner           SalonOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services        Service[]
  staff           Staff[]
  counters        Counter[]
  appointments    Appointment[]
  reviews         Review[]
  slots           Slot[]
  commissionRules CommissionRule[]
  ledgerEntries   LedgerEntry[]
  payouts         Payout[]

  @@index([latitude, longitude])
  @@index([status, isDeleted], map: "salons_status_is_deleted_idx") // already exists in DB; declaring it stops Prisma from dropping it
  @@map("salons")
}
