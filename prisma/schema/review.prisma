model Review {
  id            String   @id @default(uuid())
  /// Exactly one parent: a salon appointment or a home visit (CHECK reviews_one_parent).
  appointmentId String?  @unique
  homeBookingId String?  @unique
  /// The home expert reviewed (home visits only); their rating counts these.
  homeExpertId  String?
  customerId    String
  salonId       String
  staffId       String?
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Moderation. A hidden review keeps its text; it is only taken out of view.
  status        ReviewStatus @default(PUBLISHED)
  hiddenReason  String?
  moderatedById String?
  moderatedAt   DateTime?
  reportCount   Int          @default(0)

  // One public reply from the business, editable for 24 h after it is posted.
  // ownerReplyById is a plain user id (audit trail, no relation).
  ownerReply     String?
  ownerRepliedAt DateTime?
  ownerReplyById String?

  // Relations
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  homeBooking HomeBooking?   @relation(fields: [homeBookingId], references: [id], onDelete: Cascade)
  homeExpert  HomeExpert?    @relation(fields: [homeExpertId], references: [id], onDelete: SetNull)
  customer    User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salon       Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff       Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  reports     ReviewReport[]

  @@index([salonId, status])
  @@index([status, createdAt])
  @@index([homeExpertId, status])
  @@map("reviews")
}

/// One report per user per review. The reporter is never shown to the reviewer.
model ReviewReport {
  id         String   @id @default(uuid())
  reviewId   String
  reporterId String
  reason     String // ABUSIVE | PERSONAL_INFO | SPAM | FAKE | OTHER
  note       String?
  createdAt  DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@map("review_reports")
}

/// What a business keeps about one of its customers. Never sent to the
/// customer: only the /owner/customers endpoints read it.
model CustomerNote {
  id          String   @id @default(uuid())
  ownerId     String // SalonOwner.id - the business, shared by its branches
  customerId  String
  note        String? // <= 1000 chars
  tags        String[] // <= 10, each <= 24 chars, lower-case
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, customerId])
  @@map("customer_notes")
}
