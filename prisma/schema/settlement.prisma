/// How much the platform charges for a booking. A rule with a null salonId is
/// the platform default; a salon-specific rule overrides it. The rule that wins
/// is the most specific one whose amount band and scope match the booking.
model CommissionRule {
  id             String          @id @default(uuid())
  salonId        String? // null = platform default
  minAmountMinor Int             @default(0)
  maxAmountMinor Int?
  flatFeeMinor   Int? // e.g. 1000 = BDT 10
  percentBps     Int? // basis points. 500 = 5%
  appliesTo      CommissionScope
  isActive       Boolean         @default(true)
  priority       Int             @default(0) // higher wins among equally specific rules
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, isActive])
  @@map("commission_rules")
}

/// Double-entry record of who is owed what. Every journal (one balanced set,
/// written only by writeJournal) sums to zero across accounts - that identity
/// is the reconciliation test. journalId is the appointment id for booking
/// sets, else a fresh uuid.
model LedgerEntry {
  id            String        @id @default(uuid())
  journalId     String
  appointmentId String?
  salonId       String?
  ownerId       String? // the business; balances and payouts group on it
  account       LedgerAccount
  amountMinor   Int // signed
  description   String
  payoutId      String?
  createdAt     DateTime      @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  salon       Salon?       @relation(fields: [salonId], references: [id], onDelete: SetNull)
  payout      Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt])
  @@index([payoutId])
  @@index([appointmentId])
  @@index([journalId])
  @@index([ownerId, createdAt])
  @@index([account, payoutId, createdAt])
  @@map("ledger_entries")
}

/// A batch settlement to one business, rolling up its available SALON_PAYABLE
/// rows. salonId is set only when the business has a single salon in it.
/// (method, reference) is unique where reference is set - a partial index in
/// the migration, not expressible here.
model Payout {
  id                  String       @id @default(uuid())
  ownerId             String
  salonId             String?
  periodStart         DateTime
  periodEnd           DateTime
  grossMinor          Int
  commissionMinor     Int
  netMinor            Int
  status              PayoutStatus @default(PENDING)
  method              String? // BKASH | BANK
  reference           String?
  failureReason       String?
  paidAt              DateTime?
  markedPaidById      String?
  proofUrl            String?
  approvedById        String?
  approvedAt          DateTime?
  payoutAccountId     String?
  destinationSnapshot Json?
  attempt             Int          @default(1)
  cancelledReason     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  owner   SalonOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  salon   Salon?        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@index([salonId, status])
  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("payouts")
}

/// Where a business is paid. A new account is PENDING_VERIFICATION until
/// Finance verifies it; payouts only go to a VERIFIED account past its
/// cooldownUntil. Bank numbers are AES-256-GCM (fieldCrypto); only last4 is
/// ever shown without users.view_pii.
model PayoutAccount {
  id               String              @id @default(uuid())
  ownerId          String
  type             PayoutAccountType
  accountName      String
  walletNumber     String? // bKash / Nagad, 01XXXXXXXXX
  bankName         String?
  branchName       String?
  routingNumber    String? // 9 digits
  accountNumberEnc String? // fieldCrypto
  last4            String
  status           PayoutAccountStatus @default(PENDING_VERIFICATION)
  verifiedById     String?
  verifiedAt       DateTime?
  rejectionReason  String?
  cooldownUntil    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  owner SalonOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("payout_accounts")
}

/// An immutable snapshot an owner can hand to an accountant (owner Phase 7):
/// MONTHLY (a Dhaka month's SALON_PAYABLE movements), PAYOUT (written in the
/// PAID transition) or INVOICE (the month's commission, numbered from the
/// Postgres sequence owner_invoice_seq). A trigger refuses UPDATE. periodEnd is
/// exclusive. totals holds money as *Minor only; ledgerHash = sha256 of the
/// "id:amountMinor" lines it covers, so a rebuild can prove nothing moved.
model OwnerStatement {
  id          String        @id @default(uuid())
  ownerId     String
  kind        StatementKind
  number      String?       @unique // INVOICE only: SK-2026-000123
  periodStart DateTime
  periodEnd   DateTime
  payoutId    String?       @unique
  totals      Json
  ledgerHash  String
  createdAt   DateTime      @default(now())

  owner SalonOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, kind, periodStart])
  @@index([ownerId, createdAt])
  @@map("owner_statements")
}
