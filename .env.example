NODE_ENV=development
PORT=5000
# Slot times are read as server-local, so the process must run on Dhaka time.
# Set this on the host too (Render: Environment tab) - without it every slot
# is treated as 6 hours later than it is.
TZ=Asia/Dhaka

# DATABASE_URL=postgresql://postgres:12345@localhost:5432/salon_management_db?schema=public
# Neon pooled connection (host has "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon: Prisma Migrate needs a DIRECT (non-pooled) connection. Same URL without "-pooler" in the host.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"
JWT_SECRET=your-jwt-secret
EXPIRES_IN=1h
ACCESS_TOKEN_EXPIRES_IN=7d
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=90d
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- AI search (Gemini) ---------------------------------------------------
# An AI Studio key (starts with "AIza"). Without it AI search still works from
# rules, the database and PostGIS, just without semantic ranking or the reply.
# The free tier rate-limits (429) quickly: production needs billing enabled.
GEMINI_API_KEY="your-gemini-api-key"
# Changing this re-embeds every salon (the sync job does it by itself); vectors
# from two models are never compared. gemini-embedding-2 has no task_type - the
# code writes the task into the text instead.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Preference list, first that answers in time wins. Since 2026-09-18 Google
# only serves gemini-2.5-* to projects that already used them; a new project
# should lead with a 3.x Flash-Lite, e.g. gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash,gemini-3.5-flash-lite
# Results per search (1-12).
AI_SEARCH_LIMIT=6

# Shared with the frontend (same value on Vercel). Lets the rate limiters trust
# the visitor IP the Next.js server forwards in X-Client-IP; without it every
# visitor counts as the frontend server's IP. Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# --- Email ---------------------------------------------------------------
# Which transport to use: "resend" (HTTPS API) or "smtp". Leave empty and the
# first one with credentials wins, which prefers Resend.
#
# Production must not rely on SMTP: hosted free tiers (Render included) block
# outbound port 587, so nodemailer fails there with ETIMEDOUT and then
# ENETUNREACH on the IPv6 retry. The HTTPS API on 443 always gets out.
#
# Verify delivery with:  npm run test:email -- you@example.com
# Must be an address on a domain verified with the provider. Resend's shared
# onboarding@resend.dev works for testing but only delivers to the address that
# owns the Resend account.
EMAIL_PROVIDER=resend
EMAIL_FROM=Salon Management <no-reply@salon.ashrafulash.com>
RESEND_API_KEY=your_key

# SMTP, for local development or a host that allows port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ashrafulash2871@gmail.com
SMTP_PASS=SMTP_APP_PASSWORD

# Base URL used to build password-reset and email-verification links
FRONTEND_URL=http://localhost:3000

# --- Auth: email verification codes ---------------------------------------
# Signs the one-time codes (HMAC), the verification ticket and the Google
# sign-in flow cookie - three separate keys are derived from it. NEVER reuse
# JWT_SECRET here: anything signed with that is accepted as a session.
# Rotating it only cancels codes and sign-ins in flight, never sessions.
# Generate: openssl rand -hex 32
AUTH_OTP_SECRET=AUTH_OTP_SECRET
# false = the old behaviour (register signs straight in, verify link emailed).
# true  = no session until the email is confirmed with a 6-digit code; login
#         of an unverified account answers VERIFICATION_REQUIRED instead of
#         tokens. Flip it on Render only after the new frontend is live.
REQUIRE_EMAIL_VERIFICATION=false
# Development only: also print each code to the API console as
# "[otp:dev] <email> -> 123456". Ignored when NODE_ENV=production.
AUTH_DEV_LOG_OTP=false

# --- Auth: Sign in with Google (OAuth 2.0 / OpenID Connect) ---------------
# Google Cloud Console -> Google Auth Platform -> Clients -> Web application.
# Leave GOOGLE_CLIENT_ID empty to switch Google sign-in off: the routes 404
# and the frontend hides the button. The secret lives ONLY here and on Render;
# the frontend never needs either value.
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
# The FRONTEND callback (a Next.js route handler), character for character as
# registered under "Authorized redirect URIs". Render uses
# https://salon.ashrafulash.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# true  = a brand-new Google account also confirms a 6-digit code sent to its
#         Gmail before the first sign-in (the product decision for now).
# false = trust Google's email_verified claim and sign straight in (the usual
#         industry behaviour). Returning Google users never get a code.
GOOGLE_SIGNUP_REQUIRES_OTP=true

# --- Payments: SSLCommerz -----------------------------------------------
# Sandbox store first. Real credentials never belong in this file.
# The return URLs must be publicly reachable - SSLCommerz posts to them from
# its own servers, so localhost is never called. Use `ngrok http 5000` locally.
# Register SSLCZ_IPN_URL in the merchant panel too: it is not picked up from
# the API call alone.
API_URL=http://localhost:5000
SSLCZ_STORE_ID=SSLCZ_STORE_ID
SSLCZ_STORE_PASSWD=SSLCZ_STORE_PASSWD
SSLCZ_IS_LIVE=false
SSLCZ_SUCCESS_URL=https://api.yourdomain.com/api/v1/payments/sslcz/success
SSLCZ_FAIL_URL=https://api.yourdomain.com/api/v1/payments/sslcz/fail
SSLCZ_CANCEL_URL=https://api.yourdomain.com/api/v1/payments/sslcz/cancel
SSLCZ_IPN_URL=https://salon.ashrafulash.com/api/v1/payments/sslcz/ipn

# --- Payments: bKash Tokenized Checkout (SANDBOX) -----------------------
# The callback is a browser redirect, so localhost works without ngrok.
# These are bKash's public sandbox credentials, not secrets. Live credentials
# come from the bKash merchant onboarding and belong only on Render.
# bKash blocks the merchant for an hour after more than 2 Grant Token calls in
# an hour, so the token is cached rather than re-granted per request.
BKASH_ENABLED=true
BKASH_IS_LIVE=false
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
# BKASH_CALLBACK_URL=   # optional; defaults to ${API_URL}/api/v1/payments/bkash/callback

# --- Deposits and settlement --------------------------------------------
# How late a customer can be before the auto no-show job closes the booking out.
NO_SHOW_GRACE_MINUTES=20
# How long after its end a checked-in booking may stay open before a job closes
# it as completed with no payment recorded (the owner then records the payment).
STALE_CHECKOUT_HOURS=12
# Platform commission, as a percentage of the bill (not a flat fee). One rate
# for every completed booking - no peak / off-peak band, no new-versus-repeat
# customer split, no SALON_DIRECT exemption. Fractions are allowed, e.g. 7.5.
PLATFORM_COMMISSION_PERCENT=10
# Set true to stop this process running reconciliation and no-show jobs.
DISABLE_BACKGROUND_JOBS=false

# --- Geocoding (address search and pin reverse lookup) ------------------
# Nominatim's usage policy requires a User-Agent that identifies the app and
# gives a real contact; anonymous or generic agents get blocked.
GEOCODER_USER_AGENT="SalonManagement/1.0 (contact: you@yourdomain.com)"
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io

# --- In-chat booking assistant ------------------------------------------
# Read straight from process.env where they are used, so flipping one needs no
# code change. All optional except the token secret, which phase 4 requires.
# Set false to 404 the /assistant routes without redeploying anything else.
ASSISTANT_ENABLED=true
# false keeps the assistant in guided mode (taps only); true lets Gemini turn
# free text into the same actions.
ASSISTANT_LLM_ENABLED=false
# false while SSLCommerz is down: the chat stops offering top-ups and points at
# the wallet page instead; bookings the wallet already covers keep working.
ASSISTANT_TOPUP_ENABLED=true
# Tokens (in + out) the process may spend on typed chat per Dhaka day before
# falling back to guided mode until midnight.
ASSISTANT_DAILY_TOKEN_BUDGET=2000000
# HMAC key for the signed booking-confirmation token. Required once confirm-in-
# chat ships; rotating it invalidates every unconfirmed booking in flight.
ASSISTANT_TOKEN_SECRET="<32+ random bytes, base64>"
# How many days ahead the assistant offers dates, and how far the readiness
# script (npm run assistant:check) looks for free slots.
ASSISTANT_MAX_DAYS=14
# How long a slot is held for a customer mid-conversation before it is released.
ASSISTANT_HOLD_MINUTES=10
