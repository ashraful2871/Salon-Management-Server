NODE_ENV=development
PORT=5000
# Slot times are read as server-local, so the process must run on Dhaka time.
# Set this on the host too (Render: Environment tab) - without it every slot
# is treated as 6 hours later than it is.
TZ=Asia/Dhaka
# DATABASE_URL=postgresql://postgres:12345@localhost:5432/salon_management_db?schema=public
# Neon pooled connection (host has "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon: Prisma Migrate needs a DIRECT (non-pooled) connection. Same URL without "-pooler" in the host.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"
JWT_SECRET=your-jwt-secret
EXPIRES_IN=1h
ACCESS_TOKEN_EXPIRES_IN=7d
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=90d
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
GEMINI_API_KEY="your-gemini-api-key"

# --- Email ---------------------------------------------------------------
# Which transport to use: "resend" (HTTPS API) or "smtp". Leave empty and the
# first one with credentials wins, which prefers Resend.
#
# Production must not rely on SMTP: hosted free tiers (Render included) block
# outbound port 587, so nodemailer fails there with ETIMEDOUT and then
# ENETUNREACH on the IPv6 retry. The HTTPS API on 443 always gets out.
#
# Verify delivery with:  npm run test:email -- you@example.com
# Must be an address on a domain verified with the provider. Resend's shared
# onboarding@resend.dev works for testing but only delivers to the address that
# owns the Resend account.
EMAIL_PROVIDER=resend
EMAIL_FROM=Salon Management <no-reply@salon.ashrafulash.com>
RESEND_API_KEY=your_key

# SMTP, for local development or a host that allows port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ashrafulash2871@gmail.com
SMTP_PASS=SMTP_APP_PASSWORD

# Base URL used to build password-reset and email-verification links
FRONTEND_URL=http://localhost:3000

# --- Payments: SSLCommerz -----------------------------------------------
# Sandbox store first. Real credentials never belong in this file.
# The return URLs must be publicly reachable - SSLCommerz posts to them from
# its own servers, so localhost is never called. Use `ngrok http 5000` locally.
# Register SSLCZ_IPN_URL in the merchant panel too: it is not picked up from
# the API call alone.
API_URL=http://localhost:5000
SSLCZ_STORE_ID=SSLCZ_STORE_ID
SSLCZ_STORE_PASSWD=SSLCZ_STORE_PASSWD
SSLCZ_IS_LIVE=false
SSLCZ_SUCCESS_URL=https://api.yourdomain.com/api/v1/payments/sslcz/success
SSLCZ_FAIL_URL=https://api.yourdomain.com/api/v1/payments/sslcz/fail
SSLCZ_CANCEL_URL=https://api.yourdomain.com/api/v1/payments/sslcz/cancel
SSLCZ_IPN_URL=https://salon.ashrafulash.com/api/v1/payments/sslcz/ipn

# --- Deposits and settlement --------------------------------------------
# How late a customer can be before the auto no-show job closes the booking out.
NO_SHOW_GRACE_MINUTES=20
# How long after its end a checked-in booking may stay open before a job closes
# it as completed with no payment recorded (the owner then records the payment).
STALE_CHECKOUT_HOURS=12
# Platform commission, as a percentage of the bill (not a flat fee). One rate
# for every completed booking - no peak / off-peak band, no new-versus-repeat
# customer split, no SALON_DIRECT exemption. Fractions are allowed, e.g. 7.5.
PLATFORM_COMMISSION_PERCENT=10
# Set true to stop this process running reconciliation and no-show jobs.
DISABLE_BACKGROUND_JOBS=false

# --- Geocoding (address search and pin reverse lookup) ------------------
# Nominatim's usage policy requires a User-Agent that identifies the app and
# gives a real contact; anonymous or generic agents get blocked.
GEOCODER_USER_AGENT="SalonManagement/1.0 (contact: you@yourdomain.com)"
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
