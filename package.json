{
  "name": "salon-management-backend",
  "version": "1.0.0",
  "description": "Backend for Salon Management application",
  "main": "index.ts",
  "prisma": {
    "schema": "./prisma/schema"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "backfill:embeddings": "ts-node-dev --transpile-only ./src/scripts/backfillEmbeddings.ts",
    "ai:eval": "ts-node-dev --transpile-only ./src/scripts/evalAiIntent.ts",
    "ai:diagnose": "ts-node-dev --transpile-only ./src/scripts/diagnoseAiSearch.ts",
    "backfill:locations": "ts-node-dev --transpile-only ./src/scripts/backfillSalonLocations.ts",
    "verify:payments": "ts-node-dev --transpile-only ./src/scripts/verifyPayments.ts",
    "auth:check": "ts-node-dev --transpile-only ./src/scripts/authReadiness.ts",
    "auth:backfill": "ts-node-dev --transpile-only ./src/scripts/backfillAuth.ts",
    "verify:auth": "ts-node-dev --transpile-only ./src/scripts/verifyAuth.ts",
    "test:email": "ts-node-dev --transpile-only ./src/scripts/testEmail.ts",
    "check:email": "ts-node-dev --transpile-only ./src/scripts/checkEmailKey.ts",
    "assistant:check": "ts-node-dev --transpile-only ./src/scripts/assistantReadiness.ts",
    "assistant:eval": "ts-node-dev --transpile-only ./src/scripts/evalAssistant.ts",
    "assistant:load": "ts-node-dev --transpile-only ./src/scripts/assistantLoad.ts",
    "assistant:access": "ts-node-dev --transpile-only ./src/scripts/assistantAccessCheck.ts"
  },
  "keywords": [
    "salon",
    "management",
    "backend",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/client": "^6.16.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "4.18.3",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^10.9.1",
    "http-status": "^2.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.0",
    "@types/nodemailer": "^8.0.1",
    "multer": "^2.0.2",
    "prisma": "^6.17.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
