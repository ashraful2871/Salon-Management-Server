{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm start)",
      "Bash(npm run backfill:embeddings*)",
      "Bash(npm install*)",
      "Bash(npm ci)",
      "Bash(npm ls*)",
      "Bash(bun install*)",
      "Bash(npx tsc*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma migrate status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git blame*)",
      "Bash(curl -s http://localhost:5000/*)",
      "Bash(curl -s -X GET http://localhost:5000/*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npx prisma migrate resolve*)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(npx prisma db execute*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.vercel/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/prisma-generate-reminder.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
